---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const faqs = [
  {
    q: 'What is AesCode Co.?',
    a: 'AesCode Co. is a MedTech research platform and Clinical AI validation infrastructure in India, founded in 2026. It identifies clinically significant, unsolved problems, runs interdisciplinary research cohorts, and validates AI tools for real clinical deployment — in partnership with Bharati Vidyapeeth Medical College, Pune and the Koita Centre for Digital Health (KCDH), IIT Bombay.',
  },
  {
    q: 'Who founded AesCode Co.?',
    a: 'AesCode Co. was founded in 2026 by Nikhil Gour, who serves as Founder & CEO. A 19-year-old gap-year builder, he leads AesCode Co. and also runs Care & Beyond and Inwest, working at the intersection of Clinical AI, MedTech infrastructure, and health innovation in India.',
  },
  {
    q: 'What is the AesCode MedTech Hackathon?',
    a: 'The AesCode MedTech Hackathon — also referred to as the National MedTech Hackathon and India MedTech Hackathon — held its inaugural edition as AesCode Cohort 1, a two-week clinical-AI research hackathon at Bharati Vidyapeeth Medical College, Pune. It drew 250+ research abstracts, 20 finalist teams, and 5 clinically sourced problem statements, judged and mentored by clinicians and researchers from KCDH, IIT Bombay.',
  },
  {
    q: 'What is Clinical AI?',
    a: 'Clinical AI is artificial intelligence built and validated for use in real clinical settings — diagnosis, risk prediction, screening, and decision support. Unlike general-purpose AI, Clinical AI is held to medical evidentiary standards: reproducibility, clinical relevance, and safety in real-world deployment.',
  },
  {
    q: 'What is Clinical AI Validation?',
    a: 'Clinical AI Validation is the process of independently testing whether an AI tool is accurate, safe, and fit for deployment in real clinical workflows. AesCode certifies models against the conditions of Indian clinical deployment, with a pass/fail evaluation and structured feedback — each certified model contributes to a growing benchmark.',
  },
  {
    q: 'How can I participate in India’s MedTech Hackathon?',
    a: 'Participation opens with each cohort announcement. Subscribe to AesCode Co. for updates, or email partnerships@aescode.nexus to explore institutional collaboration. Cohort 2 is coming soon.',
  },
  {
    q: 'Who mentors AesCode Co.?',
    a: 'AesCode’s mentors and advisors include Dr. (Brig) S.P. Gorthi (Head of Neurology, Bharati Vidyapeeth Hospital, Pune), Dr. Raghavendran Lakshminarayan and Dr. Kshitij Jadhav (KCDH, IIT Bombay), and Dr. Varsha Vaidya (Professor of Medicine, Bharati Vidyapeeth, Pune), alongside research mentors and evaluators from the Koita Centre for Digital Health, IIT Bombay.',
  },
  {
    q: 'What does “AI as a Medical Device” mean?',
    a: 'AI as a Medical Device (AIaMD / SaMD) refers to AI software that is regulated as a medical device. AesCode aligns its research and validation work with India’s Digital Personal Data Protection (DPDP) Act 2023, the ICMR Ethical Guidelines for AI in Healthcare, and the CDSCO SaMD regulatory pathway.',
  },
  {
    q: 'Where is AesCode Co. based?',
    a: 'AesCode Co. operates in India. Its founding clinical anchor is Bharati Vidyapeeth Medical College & Bharati Hospital, Pune, with academic partnership through the Koita Centre for Digital Health (KCDH), IIT Bombay.',
  },
  {
    q: 'What is AesCode’s connection to IIT Bombay and Bharati Vidyapeeth?',
    a: 'The Koita Centre for Digital Health (KCDH) at IIT Bombay served as research-mentor and evaluation partner for Cohort 1, contributing the computational standards the program demanded. Bharati Vidyapeeth Medical College & Hospital, Pune provides the clinical foundation — a continuous source of documented clinical problems and a deployment context for validated tools.',
  },
  {
    q: 'How does AesCode protect patient data?',
    a: 'AesCode uses federated learning: selected teams train AI models on real hospital data without that data ever leaving the hospital. Only model weights move — never patient records. The architecture is privacy-preserving by design, not by policy.',
  },
];

const siteUrl = 'https://www.aescode.nexus';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl + '/' },
    { '@type': 'ListItem', position: 2, name: 'FAQ', item: siteUrl + '/faq' },
  ],
};
---

<BaseLayout
  title="FAQ — AesCode Co."
  description="Answers about AesCode Co., its founder Nikhil Gour, the AesCode MedTech Hackathon, Clinical AI validation, and partnerships with KCDH IIT Bombay and Bharati Vidyapeeth, Pune."
  jsonLd={[faqSchema, breadcrumbSchema]}
>
  <Navbar activePage="/faq" />
  <main id="main-content">

    <!-- Hero -->
    <section class="faq-hero section-hero">
      <div class="container">
        <div class="faq-hero__inner">
          <p class="label-sm mb-lg reveal" style="color:var(--accent)">KNOWLEDGE BASE</p>
          <h1 class="display-hero serif italic text-primary mb-lg reveal reveal--delay-1">Frequently Asked Questions.</h1>
          <div class="hairline hairline--short hairline--accent mb-xl reveal reveal--delay-1"></div>
          <p class="body-xl reveal reveal--delay-2" style="color:var(--on-surface-variant);max-width:44rem;line-height:1.7">What AesCode Co. is, who built it, and how the platform validates Clinical AI for India.</p>
        </div>
      </div>
    </section>

    <!-- FAQ list -->
    <section class="section-primary">
      <div class="container">
        <div class="faq-list">
          {faqs.map((f, i) => (
            <details class="faq-item reveal" open={i === 0}>
              <summary class="faq-item__q">
                <span class="serif text-primary">{f.q}</span>
                <span class="faq-item__icon mono" aria-hidden="true">+</span>
              </summary>
              <p class="faq-item__a body-md" style="color:var(--on-surface-variant);line-height:1.8">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>

<style>
  .faq-hero { padding-top:calc(68px + var(--space-6xl)); padding-bottom:var(--space-3xl); }
  .faq-hero__inner { max-width:56rem; }

  .faq-list { max-width:52rem; margin-inline:auto; }
  .faq-item {
    border-bottom:0.5px solid rgba(196,198,206,.35);
    padding-block:var(--space-xl);
  }
  .faq-item__q {
    display:flex; align-items:flex-start; justify-content:space-between;
    gap:var(--space-lg); cursor:pointer; list-style:none;
    font-size:var(--headline-md); line-height:1.3;
  }
  .faq-item__q::-webkit-details-marker { display:none; }
  .faq-item__icon {
    flex-shrink:0; color:var(--accent); font-size:1.5rem; line-height:1;
    transition:transform .25s ease;
  }
  .faq-item[open] .faq-item__icon { transform:rotate(45deg); }
  .faq-item__a { margin-top:var(--space-lg); max-width:46rem; }
</style>
